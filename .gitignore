# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/

# --- Sanal ortam ve IDE (her bilgisayarda yerel) ---
.venv/
venv/
.idea/
.vscode/

# --- Notebook ---
.ipynb_checkpoints/

# --- Veri: ham veri büyük (UCI ~127 MB, ELD ~680 MB) ve yeniden indirilebilir ---
# İşlenmiş veri de koddan yeniden üretilebilir. Klasörler .gitkeep ile korunur.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Model ağırlıkları: eğitim betikleriyle yeniden üretilir (yedek repo dışında) ---
models/*.pt
models/eld/*.pt
# Gözetimli anomali dedektörü (sentetik eğitim): python -m src.anomaly_supervised ile yeniden üretilir
models/anomaly_supervised/

# --- Kayıtlı val/test tahminleri (yeniden üretilebilir, büyük) ---
results/predictions/
results/eld/predictions/

# --- Arşiv dosyaları (model yedekleri vb. repoya girmez) ---
*.zip

# --- İşletim sistemi ---
.DS_Store
Thumbs.db

# --- Gizli bilgiler ---
.env
.env.local
.env.*.local
.streamlit/secrets.toml

# --- Yerel yapay zekâ / ajan araçlarının ayar ve çalışma klasörleri (proje kodu değil) ---
.claude/
.mcp.json
.claude-flow/
.swarm/
.ruv-swarm/
.hive-mind/
